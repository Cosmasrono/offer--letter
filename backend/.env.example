# AgentRouter takes priority when its key is set. Enables analysis and scan reading.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.5

# Claude API key - enables the AI analysis and reading of photos/scanned letters.
# Get one at https://console.anthropic.com. Leave empty to run rules-only.
ANTHROPIC_API_KEY=

# Look up domain registration age (needs internet). true/false
ENABLE_DOMAIN_LOOKUP=true
# Download the current dated Home Office sponsor register for recognized UK CoS documents.
# Cached in memory for six hours; failed or stale lookups remain unverified.
ENABLE_UK_SPONSOR_LOOKUP=true

# Read public HTTPS home/contact/about pages and compare with the letter. No document is sent to websites.
ENABLE_WEBSITE_CHECK=true
# Optional independent company-name search; without a key, only domains stated in the letter are read.
# https://api-dashboard.search.brave.com/documentation/quickstart
BRAVE_SEARCH_API_KEY=
# Query the official NEA public register for named agencies (30-minute cache); fall back to a current imported snapshot.
ENABLE_NEA_LIVE_LOOKUP=true

# Official UK employer records. Leave empty to show the lookup as unavailable (never a verified employer).
# https://developer.company-information.service.gov.uk/authentication
COMPANIES_HOUSE_API_KEY=
# Optional custom NEA CSV. Import with tools/import_nea.py to include provenance and a retrieval date.
# NEA_AGENCIES_CSV=C:\path\to\nea_agencies.csv

# Comma-separated list of frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Optional: full path to tesseract.exe if installed and not on PATH (for OCR without Claude)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Shared secret the Next.js server sends (X-Api-Key). Set the same value in frontend/.env.
# Strongly recommended whenever this API is reachable from the internet.
BACKEND_API_KEY=
AI_PROVIDERS='groq,openrouter'
GROQ_API_KEY=''
GROQ_BASE_URL='https://api.groq.com/openai/v1'
GROQ_MODEL='qwen/qwen3.8-27b'
GROQ_VISION_MODEL='qwen/qwen3.8-27b'
OPENROUTER_API_KEY=''
OPENROUTER_BASE_URL='https://openrouter.ai/api/v1'
OPENROUTER_MODEL='google/gemini-2.5-flash'
OPENROUTER_VISION_MODEL='google/gemini-2.5-flash'
